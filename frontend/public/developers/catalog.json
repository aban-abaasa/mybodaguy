                {
                    "in": "query",
                    "name": "country",
                    "type": "string",
                    "example": "Uganda",
                    "required": false,
                    "description": "Filter by country."
                },
                {
                    "in": "query",
                    "name": "limit",
                    "type": "integer",
                    "default": 25,
                    "required": false,
                    "description": "1 to 100."
                },
                {
                    "in": "query",
                    "name": "offset",
                    "type": "integer",
                    "default": 0,
                    "required": false,
                    "description": "For paging."
                }
            ],
            "summary": "Stores",
            "description": "Stores on SupermarketEra with their city and what they offer.",
            "example_path": "/supermarketera/stores?city=Kampala",
            "cache_seconds": 120
        },
