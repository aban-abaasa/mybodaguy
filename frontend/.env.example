# ===========================================
# My Boda Guy - Environment Variables
# ===========================================

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# App Configuration
VITE_APP_NAME=My Boda Guy
VITE_APP_URL=https://mybodaguy.vercel.app

# Development Mode (optional)
VITE_DEVELOPMENT=false

# Journey booking server (mybodaguy/backend/server) — flight search/booking
# proxy, since the Duffel access token must never reach the browser.
VITE_MBG_JOURNEY_SERVER_URL=http://localhost:4001
