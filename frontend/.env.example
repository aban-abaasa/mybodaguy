VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imhzd3hhenB4Y2d0cWJ4ZXFjeHh3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTIxNDE1NzAsImV4cCI6MjA2NzcxNzU3MH0.ryOHQGgiEFf25Q9XA2K0akCcrQ7NcZddVfnWMdAH0DU

# App Configuration
VITE_APP_NAME=My Boda Guy
VITE_APP_URL=https://bodagoera.icanera.space

# Fully optional. Maps render with Leaflet + OpenStreetMap (no key needed)
# and address search/geocoding already falls back to free OpenStreetMap
# Nominatim. Set this only to prefer Google's geocoding results (often
# better in dense urban areas) over Nominatim's. Restrict this browser key
# to the deployed app domains. Leave unset/blank otherwise — do NOT paste
# in a placeholder value, since any non-empty string is tried as a real key.
VITE_GOOGLE_MAPS_API_KEY=

# Development Mode (optional)
VITE_DEVELOPMENT=false

# Journey booking server (mybodaguy/backend/server) — flight search/booking
# proxy, since the Duffel access token must never reach the browser.
VITE_MBG_JOURNEY_SERVER_URL=http://localhost:4001

# ====== WEBRTC CALLS (rider<->customer voice/video, "Go Live") ======
# TURN relay so calls actually connect across carrier-grade NAT and
# hotel/corporate wifi, not just when both sides are on a friendly network —
# without it, a call can ring/accept fine and still hang forever on
# "Connecting…" once real peer-to-peer media negotiation is attempted.
# Leave unset to fall back to a free public demo TURN relay (works, but
# rate-limited with no SLA). Get free credentials from metered.ca or
# Cloudflare Calls and set these three to use your own instead.
# VITE_TURN_URLS=turn:your-turn-host:3478,turn:your-turn-host:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Web Push (phone/PC alerts). PUBLIC key shared by every app on the ICANera relay -
# must equal VAPID_PUBLIC_KEY on the wallet-push Edge Function. Also set it in the host's env (e.g. Vercel).
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=BOagRpg9eslXcQOaLlwLMH_4nmTPjGeGPYNJokOPmcGOEYrMmvmOEqNb88YJOiLpkTlehMl3TPADOQ9lN6ixGDg
